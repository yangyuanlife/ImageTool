<Application x:Class="ImageTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ImageTool"
             xmlns:vm="clr-namespace:ImageTool.ViewModels"
             xmlns:views="clr-namespace:ImageTool.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 导航：按 ViewModel 类型自动映射对应视图，供 MainWindow 的 ContentControl 使用。
                 隐式 DataTemplate（无 x:Key）会在 Content 为对应 VM 类型时自动套用，
                 且自动把视图的 DataContext 设为该 VM。同一时刻只有一页在视觉树中，杜绝堆叠。 -->
            <DataTemplate DataType="{x:Type vm:ResizeViewModel}">
                <views:ResizeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConvertViewModel}">
                <views:ConvertView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompressViewModel}">
                <views:CompressView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
