<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- 全局唯一版本来源：程序集版本号统一在此维护（1.0.1），
         界面/托盘通过 VersionHelper 自动读取，避免硬编码不同步 -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面 logo：作为 WPF 资源嵌入程序集（Build Action = Resource），
         单文件发布后随 exe 一并打包，无需附带 Assets 文件夹，真正实现「单文件」。
         app.ico 由上方 <ApplicationIcon> 作为 Win32 资源嵌入 exe（Win32 图标），
         托盘图标经 Icon.ExtractAssociatedIcon 从 exe 读取，二者均无需松散文件。 -->
    <Resource Include="Assets\app_icon_1024.png" />
  </ItemGroup>

</Project>
