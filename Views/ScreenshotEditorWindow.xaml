<Window x:Class="ImageTool.Views.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图编辑" WindowStyle="None" WindowState="Maximized" Topmost="True"
        Background="#1e1e1e" KeyDown="Window_KeyDown">
    <Grid>
        <!-- ===================== 画布区（可缩放 / 平移） ===================== -->
        <ScrollViewer x:Name="Scroller" Background="#1e1e1e"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      CanContentScroll="False">
            <Grid x:Name="CanvasGrid">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale"/>
                </Grid.LayoutTransform>
                <Image x:Name="ScreenshotImage" Stretch="None" SnapsToDevicePixels="True"/>
                <!-- 标注层（接收鼠标事件） -->
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseDown="Overlay_MouseDown"
                        MouseMove="Overlay_MouseMove"
                        MouseUp="Overlay_MouseUp"/>
                <!-- 选择层（非交互，仅视觉：区域外变暗 + 选区边框 + 8 个调整手柄） -->
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>

        <!-- ===================== 浮动图标工具栏（参考 Snipaste / QQ / 微信截图） ===================== -->
        <Border x:Name="ToolBar" Style="{StaticResource ToolbarPill}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 导入现有图片 -->
                <Button x:Name="BtnOpen" Style="{StaticResource ToolIconButton}" ToolTip="打开图片 (O)" Click="BtnOpen_Click">
                    <Path Style="{StaticResource IconFill}" Data="M4 5 H14 L16 7 H20 V19 H4 Z M4 5 V19 M9 11 H15 M12 8 V14"/>
                </Button>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 工具 -->
                <Button x:Name="BtnSelect" Style="{StaticResource ToolIconButton}" ToolTip="选择区域 / 移动 (V)" Click="BtnSelect_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M6 3 L6 19 L10 15 L13 21 L16 20 L13 14 L19 14 Z"/>
                </Button>
                <Button x:Name="BtnPen" Style="{StaticResource ToolIconButton}" ToolTip="画笔 (P)" Click="BtnPen_Click">
                    <Path Style="{StaticResource IconFill}" Data="M4 20 L4 16 L16 4 L20 8 L8 20 Z"/>
                </Button>
                <Button x:Name="BtnRect" Style="{StaticResource ToolIconButton}" ToolTip="矩形 (R)" Click="BtnRect_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M5 7 H19 V17 H5 Z"/>
                </Button>
                <Button x:Name="BtnArrow" Style="{StaticResource ToolIconButton}" ToolTip="箭头 (A)" Click="BtnArrow_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M4 20 L20 4 M20 4 L14 4 M20 4 L20 10"/>
                </Button>
                <Button x:Name="BtnText" Style="{StaticResource ToolIconButton}" ToolTip="文字 (T)" Click="BtnText_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M6 18 L12 6 L18 18 M8.5 13 H15.5"/>
                </Button>
                <Button x:Name="BtnHighlight" Style="{StaticResource ToolIconButton}" ToolTip="高亮 (H)" Click="BtnHighlight_Click">
                    <Path Style="{StaticResource IconFill}" Data="M2 12 L6 8 V16 Z M6 8 H19 V16 H6 Z"/>
                </Button>
                <Button x:Name="BtnMosaic" Style="{StaticResource ToolIconButton}" ToolTip="马赛克 (M)" Click="BtnMosaic_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M4 4 H20 V20 H4 Z M4 9.3 H20 M4 14.7 H20 M9.3 4 V20 M14.7 4 V20"/>
                </Button>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 颜色色板 -->
                <Button x:Name="SwRed" Tag="Red" Background="Red" Style="{StaticResource ColorSwatch}" ToolTip="红" Click="Swatch_Click"/>
                <Button x:Name="SwYellow" Tag="Yellow" Background="Yellow" Style="{StaticResource ColorSwatch}" ToolTip="黄" Click="Swatch_Click"/>
                <Button x:Name="SwGreen" Tag="Lime" Background="Lime" Style="{StaticResource ColorSwatch}" ToolTip="绿" Click="Swatch_Click"/>
                <Button x:Name="SwBlue" Tag="DodgerBlue" Background="DodgerBlue" Style="{StaticResource ColorSwatch}" ToolTip="蓝" Click="Swatch_Click"/>
                <Button x:Name="SwBlack" Tag="Black" Background="Black" Style="{StaticResource ColorSwatch}" ToolTip="黑" Click="Swatch_Click"/>
                <Button x:Name="SwWhite" Tag="White" Background="White" Style="{StaticResource ColorSwatch}" ToolTip="白" Click="Swatch_Click"/>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 粗细（画笔/矩形/箭头/高亮） -->
                <Button x:Name="BtnSizeS" Tag="2" Style="{StaticResource ToolIconButton}" ToolTip="细" Click="BtnSize_Click">
                    <Ellipse Width="6" Height="6" Fill="#E5E7EB"/>
                </Button>
                <Button x:Name="BtnSizeM" Tag="4" Style="{StaticResource ToolIconButton}" ToolTip="中" Click="BtnSize_Click">
                    <Ellipse Width="10" Height="10" Fill="#E5E7EB"/>
                </Button>
                <Button x:Name="BtnSizeL" Tag="8" Style="{StaticResource ToolIconButton}" ToolTip="粗" Click="BtnSize_Click">
                    <Ellipse Width="14" Height="14" Fill="#E5E7EB"/>
                </Button>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 文字选项：字体 + 字号（仅文字工具时重点使用，常驻以便随时调整） -->
                <ComboBox x:Name="FontCombo" Width="128" Height="28" Margin="2,0"
                          Style="{StaticResource ComboBoxStyle}" ClipToBounds="True"
                          Background="#1F1F25" Foreground="#E5E7EB" BorderBrush="#3A3A42"
                          ToolTip="字体" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="FontSizeCombo" Width="60" Height="28" Margin="4,0,2,0"
                          Style="{StaticResource ComboBoxStyle}" ClipToBounds="True"
                          Background="#1F1F25" Foreground="#E5E7EB" BorderBrush="#3A3A42"
                          ToolTip="字号" VerticalContentAlignment="Center"/>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 操作 -->
                <Button x:Name="BtnUndo" Style="{StaticResource ToolIconButton}" ToolTip="撤销 (Ctrl+Z)" Click="BtnUndo_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M9 7 L4 12 L9 17 M4 12 H14 C18 12 18 6 14 6"/>
                </Button>
                <Button x:Name="BtnClear" Style="{StaticResource ToolIconButton}" ToolTip="清空" Click="BtnClear_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M5 7 H19 M9 7 V5 H15 V7 M7 7 L8 20 H16 L17 7"/>
                </Button>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 裁剪 / 导出 -->
                <Button x:Name="BtnCrop" Style="{StaticResource ToolIconButton}" ToolTip="裁剪到选区 (双击选区也可)" Click="BtnCrop_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M5 3 V9 M3 5 H9 M19 21 V15 M21 19 H15 M5 5 H19 V19 H5"/>
                </Button>
                <Button x:Name="BtnSave" Style="{StaticResource ToolIconButton}" ToolTip="保存到文件" Click="BtnSave_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M12 3 V15 M7 10 L12 15 L17 10 M5 19 H19"/>
                </Button>
                <Button x:Name="BtnCopy" Style="{StaticResource ToolIconButton}" ToolTip="复制到剪贴板" Click="BtnCopy_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M8 4 H16 V20 H8 Z M11 3 H13 V5 H11 Z M10 9 H14 M10 12 H14 M10 15 H14"/>
                </Button>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 缩放 -->
                <Button x:Name="BtnZoomOut" Style="{StaticResource ToolIconButton}" ToolTip="缩小 (Ctrl+-)" Click="BtnZoomOut_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M10 4 A6 6 0 1 0 10 16 A6 6 0 0 0 10 4 M14 14 L19 19 M7 10 H13"/>
                </Button>
                <ComboBox x:Name="ZoomCombo" Width="96" Height="28" Margin="2,0"
                          Style="{StaticResource ComboBoxStyle}" ClipToBounds="True"
                          Background="#1F1F25" Foreground="#E5E7EB" BorderBrush="#3A3A42"
                          ToolTip="缩放" VerticalContentAlignment="Center"
                          SelectedIndex="0" SelectionChanged="ZoomCombo_SelectionChanged">
                    <ComboBoxItem Tag="auto" Content="适应屏幕"/>
                    <ComboBoxItem Tag="0.5" Content="50%"/>
                    <ComboBoxItem Tag="1" Content="100%"/>
                    <ComboBoxItem Tag="1.5" Content="150%"/>
                    <ComboBoxItem Tag="2" Content="200%"/>
                </ComboBox>
                <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#E5E7EB" FontSize="12"
                           VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                <Button x:Name="BtnZoomIn" Style="{StaticResource ToolIconButton}" ToolTip="放大 (Ctrl++)" Click="BtnZoomIn_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M10 4 A6 6 0 1 0 10 16 A6 6 0 0 0 10 4 M14 14 L19 19 M10 7 V13 M7 10 H13"/>
                </Button>
                <Button x:Name="BtnFit" Style="{StaticResource ToolIconButton}" ToolTip="适应屏幕 (Ctrl+0)" Click="BtnFit_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15"/>
                </Button>

                <Border Style="{StaticResource ToolbarSep}"/>

                <!-- 关闭 -->
                <Button x:Name="BtnClose" Style="{StaticResource ToolIconButton}" ToolTip="关闭 (Esc)" Click="BtnClose_Click">
                    <Path Style="{StaticResource IconStroke}" Data="M6 6 L18 18 M18 6 L6 18"/>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
