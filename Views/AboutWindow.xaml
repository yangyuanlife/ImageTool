<Window x:Class="ImageTool.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ImageTool.Helpers"
        Title="关于 ImageTool" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False"
        Icon="pack://siteoforigin:,,,/Assets/app.ico"
        Background="{StaticResource ContentBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="28">
        <Border Style="{StaticResource Card}" Padding="28,26">
            <StackPanel>
                <!-- 头部：logo + 名称 + 版本 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource SidebarBrush}"
                            Margin="0,0,16,0">
                        <Image Source="pack://siteoforigin:,,,/Assets/app_icon_1024.png" Width="56" Height="56"
                               RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ImageTool" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static helpers:VersionHelper.VersionWithPrefix}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Resize · Convert · Compress" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 简介 -->
                <TextBlock Text="一个轻量、开源的 Windows 图片处理工具，集截图标注、调整大小、格式转换与智能压缩于一体。基于 WPF + .NET 与 SixLabors.ImageSharp 打造，专注简洁高效的本地化体验。"
                           Style="{StaticResource HintText}" Margin="0,14,0,0" LineHeight="20"/>

                <!-- 分隔线 -->
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,16"/>

                <!-- 开源仓库 -->
                <TextBlock Text="开源仓库" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <Path Data="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M3 12 H21 M12 3 C 7 7 7 17 12 21 C 17 17 17 7 12 3"
                          Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Fill="{x:Null}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://github.com/yangyuanlife/ImageTool"
                                   RequestNavigate="Hyperlink_RequestNavigate">GitHub：github.com/yangyuanlife/ImageTool</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M3 12 H21 M12 3 C 7 7 7 17 12 21 C 17 17 17 7 12 3"
                          Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Fill="{x:Null}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://gitee.com/yangyuanlife/ImageTool"
                                   RequestNavigate="Hyperlink_RequestNavigate">Gitee：gitee.com/yangyuanlife/ImageTool</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- 联系方式 -->
                <TextBlock Text="联系方式" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M3 6 H21 V18 H3 Z M3 7 L12 13 L21 7"
                          Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Fill="{x:Null}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="mailto:yangyuanlife@qq.com"
                                   RequestNavigate="Hyperlink_RequestNavigate">yangyuanlife@qq.com</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- 底部版权（关闭用窗口标题栏按钮即可） -->
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14"/>
                <TextBlock Text="{Binding Copyright, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
