<Window x:Class="ImageTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImageTool.Views"
        xmlns:helpers="clr-namespace:ImageTool.Helpers"
        Title="图片处理工具" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource ContentBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei, sans-serif">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏（深色） -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,24,18,20" HorizontalAlignment="Center">
                    <Image Source="Assets/app_icon_1024.png" Width="164" Height="164" Margin="0,0,0,12"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           UseLayoutRounding="True"/>
                    <TextBlock Text="图片处理工具" FontSize="16" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Resize · Convert · Compress" FontSize="11"
                               Foreground="{StaticResource SidebarMutedBrush}" Margin="0,3,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         Style="{StaticResource SidebarList}" ItemContainerStyle="{StaticResource SidebarItem}"
                         DockPanel.Dock="Top">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{Binding IconPath}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 版本号：独立固定在侧边栏最底部，避免把上方按钮顶上去 / 被遮挡 -->
                <TextBlock DockPanel.Dock="Bottom" FontSize="10"
                           Foreground="{StaticResource SidebarMutedBrush}"
                           Margin="0,0,0,10" HorizontalAlignment="Center"
                           Text="{x:Static helpers:VersionHelper.VersionWithPrefix}"/>

                <!-- 快捷操作区：固定在版本号上方，自身高度固定，版本号不再挤压它 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,18,6" VerticalAlignment="Bottom">
                    <!-- 分隔线 + 区标题：把上方「导航菜单」和下方「动作按钮」在视觉上切开 -->
                    <Border Height="1" Background="#FFFFFF22" Margin="0,0,0,12"/>
                    <TextBlock Text="快捷操作" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}"
                               Margin="2,0,0,10"/>
                    <Button Style="{StaticResource SidebarActionButton}"
                            Click="OpenImageButton_Click" Padding="10,9" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M3 7 H8 L10 9 H21 V19 H3 Z" Stroke="White" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Fill="{x:Null}" Stretch="Uniform"
                                  Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="打开图片" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarActionButton}"
                            Click="ScreenshotButton_Click" Padding="10,9" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M5 8 H7 L8 6 H16 L17 8 H19 V18 H5 Z M12 10 A3 3 0 1 0 12 16 A3 3 0 1 0 12 10"
                                  Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="{x:Null}"
                                  Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="截图" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource SidebarMutedBrush}" Margin="2,7,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="快捷键 "/><Run Text="{Binding ScreenshotHotkeyHint}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容区（浅色）：用 ContentControl 承载当前页。
             只显示 CurrentPage 对应的那一页视图，绝不会多页堆叠。 -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
